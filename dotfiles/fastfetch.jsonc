// fastfetch equilibrado: logo Debian, dois grupos curtos (sistema e hardware).
// Só cores ANSI (sem hex): trocar o tema do terminal recolore tudo.
// No Terminal Green 1999 a cor 8 (bright_black) é ilegível: não usar em texto.
// Ícones Nerd Font gravados como \uXXXX para não sumirem em edições.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "debian",
    "color": { "1": "green", "2": "bright_white" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "green", "output": "default" },
    "size": { "binaryPrefix": "iec", "ndigits": 1 }
  },
  "modules": [
    // Usuário do sistema e um apelido fixo no lugar do nome da máquina.
    { "type": "title", "format": "{#1;92}{user-name}{#37} @ {#1;92}thinkpad" },
    { "type": "custom", "format": "{#37}──────────────────────────────" },
    { "type": "os",       "key": "", "format": "{id} {version-id} {codename}" },
    { "type": "kernel",   "key": "", "format": "{release}" },
    { "type": "packages", "key": "󰏖", "format": "{dpkg} dpkg · {flatpak-all} flatpak" },
    { "type": "de",       "key": "", "format": "{pretty-name} {version}" },
    { "type": "shell",    "key": "", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "", "format": "{pretty-name}" },
    { "type": "custom", "format": "{#37}──────────────────────────────" },
    { "type": "cpu",    "key": "󰻠", "keyColor": "blue", "format": "{name}", "temp": false },
    // Dois módulos só para mostrar "AMD Radeon" e "Intel UHD" sem repetir o fabricante.
    { "type": "gpu",    "key": "󰢮", "keyColor": "blue", "format": "{name}", "hideType": "integrated", "detectionMethod": "pci", "temp": false },
    { "type": "gpu",    "key": "󰢮", "keyColor": "blue", "format": "{vendor} {name}", "hideType": "discrete", "detectionMethod": "pci", "temp": false },
    { "type": "memory", "key": "󰑭", "keyColor": "blue", "format": "{used} / {total}" },
    { "type": "disk",   "key": "󰋊", "keyColor": "blue", "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "uptime", "key": "󰅐", "keyColor": "blue", "format": "{?days}{days}d {?}{hours}h {minutes}m" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
